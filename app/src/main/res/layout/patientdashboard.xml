<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFF7D6"
    tools:context=".PatientDashboard">

    <!-- Top Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="89dp"
        android:background="#FFF3B9"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="8dp">

        <!-- Logo on the left -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="145dp"
            android:layout_height="87dp"
            android:scaleType="fitCenter"
            android:src="@drawable/__10" />

        <!-- Name + Role stacked vertically -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingEnd="19dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:fontFamily="@font/popsemibold"
                android:text=""
                android:textColor="#000000"
                android:textSize="16sp"
                />

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/popreg"
                android:text="Patient"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>



        <!-- Profile icon on the right -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pprofile1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/circle_gray"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            app:strokeColor="#000000"/>
    </LinearLayout>


    <!-- Illustration and tagline -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="335dp"
        android:padding="1dp">


        <!-- Your existing illustration -->

        <!-- Your existing text -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/illustration"
            android:layout_width="272dp"
            android:layout_height="314dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="137dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Illustration"
            android:scaleType="centerCrop"
            android:src="@drawable/background_image"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle" />

        <TextView
            android:id="@+id/text_description1"
            android:layout_width="190dp"
            android:layout_height="154dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="4dp"
            android:layout_marginTop="110dp"
            android:layout_marginEnd="216dp"
            android:layout_marginBottom="70dp"
            android:fontFamily="@font/popreg"
            android:lineSpacingExtra="4dp"
            android:text="Your wellbeing matters. GlimmerMind is here to support every step of your journey, helping you feel heard, understood, and cared for."
            android:textColor="#000000"
            android:textSize="12sp" />


    </RelativeLayout>

    <!-- Grid Buttons Section -->


    <GridLayout
        android:layout_width="314dp"
        android:layout_height="293dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2"
        android:rowOrderPreserved="false"
        tools:layout_editor_absoluteX="70dp"
        tools:layout_editor_absoluteY="70dp">


        <!-- Manage Profile -->
        <LinearLayout
            android:id="@+id/btnManageProfile1"
            android:layout_width="138dp"
            android:layout_height="127dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/image_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/manpro2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:onClick="onImageClick"
                android:src="@drawable/profile"
                app:tint="#68382E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:fontFamily="@font/popreg"
                android:text="Manage Profile"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Book Appointment -->
        <LinearLayout
            android:id="@+id/btnAvail"
            android:layout_width="138dp"
            android:layout_height="127dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/image_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginBottom="5dp"
                android:onClick="onImageClick"
                android:src="@drawable/appoint"
                app:tint="#68382E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:fontFamily="@font/popreg"
                android:text="Book an appointment calender"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Assessment Test -->
        <LinearLayout
            android:id="@+id/btnDash"
            android:layout_width="138dp"
            android:layout_height="127dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/image_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="55dp"
                android:onClick="onImageClick"
                android:src="@drawable/test"
                app:tint="#68382E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:fontFamily="@font/popreg"
                android:text="Take Assessment Test"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- About Us -->
        <LinearLayout
            android:id="@+id/btnAbout"
            android:layout_width="138dp"
            android:layout_height="127dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/image_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="69dp"
                android:layout_height="70dp"
                android:onClick="onImageClick"
                android:src="@drawable/aboutus"
                app:tint="#68382E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:fontFamily="@font/popreg"
                android:text="About Us"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>
    </GridLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#FFF7D6"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Container for the nav items -->
        <LinearLayout
            android:id="@+id/thefooterContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/theicon_home"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:contentDescription="Home"
                    android:src="@drawable/navhomeon" />

                <TextView
                    android:id="@+id/text_home1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/popreg"
                    android:text="Home"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Appointments -->
            <LinearLayout
                android:id="@+id/nav_appointments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/theicon_appointments"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:contentDescription="Appointments"
                    android:src="@drawable/navappointoff" />

                <TextView
                    android:id="@+id/text_appointments1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/popreg"
                    android:text="Appointments"
                    android:textColor="#000000"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Notifications -->

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/nav_notifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/theicon_notifications"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:contentDescription="Notifications"
                    android:src="@drawable/navnotifoff" />

                <TextView
                    android:id="@+id/text_notifications1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/popreg"
                    android:text="Notifications"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/theicon_profile"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/navprofoff" />

                <TextView
                    android:id="@+id/text_profile1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/popreg"
                    android:text="Profile"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</LinearLayout>