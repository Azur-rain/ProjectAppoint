<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFF7D1"
    tools:context=".assessmenttestresult1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/popbold"
            android:onClick="onHomeClicked"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_arrow_backblack"
            android:drawablePadding="5dp"
            android:paddingStart="0dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:minHeight="48dp"
            android:text="Home"
            android:textColor="#000000"
            android:textSize="@dimen/caption_text_size"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/heading_assessment_result1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_assessment_result"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/popbold"
            android:textColor="#000000"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/paragraph_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_paragraph"
            android:gravity="center"
            android:textSize="@dimen/body_text_size"
            android:fontFamily="@font/popreg"
            android:textColor="#000000"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:id="@+id/subheading_phq9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subheading_phq9"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/popsemibold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0,1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="48dp">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DACFAE">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="@string/table_header_col1"
                    android:gravity="center"
                    android:textSize="@dimen/body_text_size"
                    android:fontFamily="@font/popreg"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="@string/table_header_col2"
                    android:gravity="center"
                    android:textSize="@dimen/body_text_size"
                    android:fontFamily="@font/popreg"
                    android:textColor="#000000" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3B9">

                <TextView
                    android:id="@+id/scalescore"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="@string/table_data_score"
                    android:gravity="center"
                    android:textSize="@dimen/body_text_size"
                    android:fontFamily="@font/popreg"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/diagnosis"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="@string/table_data_diagnosis"
                    android:gravity="center"
                    android:textSize="@dimen/body_text_size"
                    android:fontFamily="@font/popreg"
                    android:textColor="#000000" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/subheading_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subheading_cta"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/popsemibold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_book_appointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:layout_gravity="center_horizontal"
            android:textSize="14sp"
            android:fontFamily="@font/popbold"
            android:textColor="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:onClick="onBookAppointmentClicked"
            app:cornerRadius="100dp"
            android:backgroundTint="#68382E"/>


    </LinearLayout>
</ScrollView>