<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFF7D6"
    tools:context=".pt_activity_main">

    <!-- Top Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="89dp"
        android:background="#FFF3B9"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="8dp">

        <!-- Logo on the left -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="145dp"
            android:layout_height="87dp"
            android:scaleType="fitCenter"
            android:src="@drawable/__10" />

        <!-- Name + Role stacked vertically -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingEnd="19dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:fontFamily="@font/popsemibold"
                android:text=""
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/popreg"
                android:text="Patient"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Profile icon on the right -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pprofile1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/circle_gray"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            app:strokeColor="#000000"/>
    </LinearLayout>

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/btn_left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/popbold"
                android:text="Book an Appointment"
                android:textColor="#000000"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Appointment Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Month Navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous Month"
                        android:src="@drawable/btn_left" />

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="October 2025"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next Month"
                        android:src="@drawable/btn_right" />
                </LinearLayout>

                <!-- Appointment Slots -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Page Navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <ImageButton
                        android:id="@+id/btnPrevPage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous Page"
                        android:src="@drawable/btn_left" />

                    <TextView
                        android:id="@+id/tvPageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Page 1 of 5"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnNextPage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next Page"
                        android:src="@drawable/btn_right" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Book Appointment Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBookAppointment"
            android:layout_width="215dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/btn_appoint"
            android:backgroundTint="@color/button_brown"
            android:fontFamily="@font/popbold"
            android:text="Book Appointment"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Bottom Nav Bar -->
    <LinearLayout
        android:id="@+id/thefooterContainer"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#FFF7D6"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/theicon_home"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:contentDescription="Home"
                android:src="@drawable/navhomeoff" />

            <TextView
                android:id="@+id/text_home1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/popreg"
                android:text="Home"
                android:textColor="#000000"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Appointments -->
        <LinearLayout
            android:id="@+id/nav_appointments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/theicon_appointments"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:contentDescription="Appointments"
                android:src="@drawable/navappointon" />

            <TextView
                android:id="@+id/text_appointments1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/popreg"
                android:text="Appointments"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/nav_notifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/theicon_notifications"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:contentDescription="Notifications"
                android:src="@drawable/navnotifoff" />

            <TextView
                android:id="@+id/text_notifications1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/popreg"
                android:text="Notifications"
                android:textColor="#000000"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/theicon_profile"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:contentDescription="Profile"
                android:src="@drawable/navprofoff" />

            <TextView
                android:id="@+id/text_profile1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/popreg"
                android:text="Profile"
                android:textColor="#000000"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
